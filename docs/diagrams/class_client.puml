@startuml class_client
!pragma layout smetana
skinparam dpi 150

class SplashScreen {
  -_start()
}
class LoginScreen {
  -_submit()
}
class RegisterScreen {
  -_submit()
}
class HomeScreen {
  -_loadMeta()
  -_loadHistory()
  -_applyFilter()
  -_onSearchChanged()
  -_openFilters()
  -_toggleFavorite()
}
class ShoeDetailScreen {
  -_load()
  -_toggleFavorite()
  -_book()
  -_addReview()
  -_deleteReview()
}
class FavoritesScreen {
  -_remove()
  -_open()
}
class OrdersScreen {
  -_load()
  -_decide()
  -_cancel()
}
class ProfileScreen {
  -_loadStats()
}
class FilterSheet {
  -_reset()
  -_apply()
}
class NotificationBell

class AuthProvider {
  +User? user
  +bool isAdmin
  +tryRestoreSession()
  +login()
  +register()
  +logout()
}
class NotificationProvider {
  +int unread
  +start()
  +stop()
  +refresh()
  +markAllRead()
}
class ThemeProvider {
  +ThemeMode mode
  +load()
  +setMode()
}
class ApiService {
  -String? _token
  +login()
  +register()
  +me()
  +getShoes()
  +getShoe()
  +setFavorite()
  +getReviews()
  +createOrder()
  +getOrders()
  +getUnreadCount()
  -_send()
}
class StorageService {
  +getToken()
  +saveToken()
  +clearToken()
  +getTheme()
  +saveTheme()
  +getSearchHistory()
  +addSearchQuery()
}
class ApiException {
  +String message
  +int? statusCode
}
class PagedShoeList {
  +reload()
  -_onScroll()
  -_loadMore()
}
class ShoeCard

class User {
  +int id
  +String login
  +String name
  +String role
  +bool blocked
}
class Shoe {
  +int id
  +String name
  +String brand
  +String category
  +String gender
  +int price
  +int oldPrice
  +List<String> sizes
  +bool inStock
  +double rating
  +bool isFavorite
}
class Order {
  +int id
  +int userId
  +int shoeId
  +String size
  +String phone
  +String status
  +String adminComment
  +bool isNew
}
class Review {
  +int id
  +int shoeId
  +int userId
  +int rating
  +String text
}
class ShoeFilter {
  +String query
  +String? category
  +String? gender
  +Set<String> brands
  +String sort
  +toQuery()
}
class ShoePage {
  +List<Shoe> items
  +int total
}
class CatalogMeta {
  +List<String> brands
  +List<String> sizes
  +int minPrice
  +int maxPrice
}

SplashScreen --> AuthProvider
LoginScreen --> AuthProvider
RegisterScreen --> AuthProvider
LoginScreen --> StorageService
HomeScreen --> PagedShoeList
HomeScreen --> FilterSheet
HomeScreen --> NotificationBell
HomeScreen --> ApiService
HomeScreen --> StorageService
FavoritesScreen --> PagedShoeList
FavoritesScreen --> ApiService
ShoeDetailScreen --> ApiService
ShoeDetailScreen --> AuthProvider
OrdersScreen --> ApiService
OrdersScreen --> NotificationProvider
ProfileScreen --> ThemeProvider
ProfileScreen --> ApiService
NotificationBell --> NotificationProvider
FilterSheet --> ShoeFilter
FilterSheet --> CatalogMeta
PagedShoeList --> ShoeCard
PagedShoeList --> ShoePage
ShoeCard --> Shoe

AuthProvider --> ApiService
AuthProvider --> StorageService
NotificationProvider --> ApiService
ThemeProvider --> StorageService
ApiService ..> ApiException : throws
ApiService --> Shoe
ApiService --> Order
ApiService --> Review
AuthProvider --> User

ShoePage "1" o-- "0..*" Shoe : contains
User "1" -- "0..*" Order : creates
Shoe "1" -- "0..*" Order : reserved in
Shoe "1" -- "0..*" Review : has
User "1" -- "0..*" Review : writes
@enduml
